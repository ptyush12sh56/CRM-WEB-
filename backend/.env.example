DATABASE_URL=sqlite:///./crm.db
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: set this to have /contacts/{id}/draft-email call the real Claude API.
# Without it, the endpoint falls back to a stage-based template.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
